{
  "llm": {
    "base_url": "http://127.0.0.1:11434/v1",
    "models": {
      "planner": "ishti-qwen2.5:14b",
      "coder": "ishti-qwen2.5-coder:14b",
      "fast": "llama3.2:3b",
      "translator": "gemma3:4b"
    },
    "fallback": "qwen2.5:14b",
    "timeout_s": 120
  },
  "memory": {
    "db_path": "D:\\ISHTI\\data\\ishti.db",
    "chroma_dir": "D:\\ISHTI\\data\\chroma",
    "embed_model": "nomic-embed-text",
    "embed_url": "http://127.0.0.1:11434",
    "search_roots": ["D:\\", "~\\Desktop", "~\\Downloads"],
    "search_max_depth": 4,
    "search_budget_s": 10
  },
  "router": {
    "use_laya": true,
    "laya_model": "typed-decisions",
    "min_confidence": 0.2,
    "default_skill": "chat"
  },
  "mcp_servers": {
    "browser": {
      "note": "Owner's Chrome 'Profile 10' (search + Google logins) via the Playwright Extension; token in data/mcp_tokens.json",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82", "--extension", "--profile-dir-name", "Profile 10",
               "--output-dir", "D:\\ISHTI\\data\\mcp_output"],
      "token_key": "browser",
      "fallback": "browser_isolated"
    },
    "whatsapp": {
      "note": "Owner's Chrome 'Profile 9' (WhatsApp Web) via the Playwright Extension",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82", "--extension", "--profile-dir-name", "Profile 9",
               "--output-dir", "D:\\ISHTI\\data\\mcp_output"],
      "token_key": "whatsapp"
    },
    "browser_isolated": {
      "note": "Fallback until the extension is set up: ISHTI's own separate profile, no logins",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82", "--user-data-dir", "D:\\ISHTI\\data\\mcp_browser_profile",
               "--output-dir", "D:\\ISHTI\\data\\mcp_output"]
    }
  },
  "voice": {
    "whisper_model": "large-v3",
    "whisper_device": "cuda",
    "whisper_compute": "int8_float16",
    "wake_enabled": true,
    "wake_model": "hey_jarvis",
    "wake_phrases": ["hey ishti", "hey jarvis", "hey my assistant"],
    "languages": ["en", "ur", "ps"],
    "wake_threshold": 0.5,
    "barge_in": {"enabled": true, "vad_threshold": 0.6, "min_ms": 120, "check_ms": 700, "echo_overlap": 0.5, "cooldown_s": 1.0,
                 "note": "Tune on the real room: raise vad_threshold/min_ms if speaker echo interrupts; lower echo_overlap if your own words get ignored"},
    "piper_voice": "en_US-lessac-medium",
    "piper_dir": "D:\\ISHTI\\data\\piper"
  }
}
