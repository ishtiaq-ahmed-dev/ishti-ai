{
  "llm": {
    "base_url": "http://127.0.0.1:11434/v1",
    "models": {
      "planner": "ishti-spark2.5:4b",
      "coder": "ishti-qwen2.5-coder:14b",
      "fast": "laya",
      "translator": "gemma3:4b"
    },
    "fallback": "ishti-qwen2.5:14b",
    "timeout_s": 120
  },
  "arch": {
    "active": "arch1",
    "note": "active: arch1 (existing dispatcher) or arch2 (intent-router -> qwen3:14b think/tool loop -> validation -> qwen3:14B final). Switch here, from the dashboard Settings -> Architecture card, or by asking ISHTI. arch2 memory adds a five-table unified store on SQLite + the existing Chroma; nothing else changes.",
    "arch2": {
      "models": {
        "main": "qwen3:14b",
        "validation": "qwen3:14b",
        "fallback": "ishti-qwen2.5:14b"
      },
      "memory": {
        "db_name": "arch2_memory.db",
        "retrieval_k": 6,
        "max_distance": 0.45,
        "context_budget_chars": 2600,
        "confirmation_thresholds": {
          "temporary": 2,
          "weak": 5,
          "probable": 10,
          "note": "0-2 observations = temporary; 3-5 weak; 6-10 probable; 11+ strong (promoted to semantic memory). Edit freely - nothing is hard-coded."
        },
        "decay": {
          "enabled": true,
          "run_interval_h": 12,
          "min_importance_floor": 0.55,
          "note": "Low-importance, long-unconfirmed memories are marked needs_confirmation (never deleted); importance >= floor is never decayed."
        }
      }
    },
    "active_profile": "router_single_agent"
  },
  "memory": {
    "db_path": "D:\\ISHTI\\data\\ishti.db",
    "chroma_dir": "D:\\ISHTI\\data\\chroma",
    "embed_model": "nomic-embed-text",
    "embed_url": "http://127.0.0.1:11434",
    "search_roots": [
      "D:\\",
      "~\\Desktop",
      "~\\Downloads"
    ],
    "search_max_depth": 4,
    "search_budget_s": 10
  },
  "learning": {
    "enabled": true,
    "db_path": "D:\\ISHTI\\data\\learning.db",
    "proactive": false,
    "thresholds": {
      "weak": 0.3,
      "possible": 0.6,
      "probable": 0.8,
      "strong": 0.95
    },
    "evidence": {
      "similar_request": 2,
      "widen_scope": 3,
      "candidate_rule": 3,
      "workflow": 3
    },
    "temporary_ttl_s": 3600,
    "entities": {
      "ambiguity_margin": 0.2,
      "min_confidence": 0.6
    },
    "dataset": {
      "min_quality": 0.6,
      "per_skill_cap": 0.4,
      "export_dir": "D:\\ISHTI\\data\\finetune"
    },
    "export_dir": "D:\\ISHTI\\data\\learning\\export",
    "note": "Reinforcement-like learning: feedback -> lesson -> memory/policy/dataset. Weights are NEVER changed at runtime; offline LoRA/QLoRA only (orchestrator/finetune.py) behind its eval gate. thresholds = confidence bands (spec 11); evidence = how many independent occasions before a lesson widens scope or becomes a candidate rule (spec 9/10); proactive=false means no volunteered suggestions until the owner asks."
  },
  "router": {
    "use_laya": true,
    "laya_model": "typed-decisions",
    "min_confidence": 0.2,
    "default_skill": "chat"
  },
  "mcp_servers": {
    "login": {
      "note": "Owner's Chrome 'Profile 10' - for logins only (Google sign-in, Gmail) - via the Playwright Extension; token in data/mcp_tokens.json",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82",
        "--extension",
        "--profile-dir-name",
        "Profile 10",
        "--output-dir",
        "D:\\ISHTI\\data\\mcp_output"
      ],
      "token_key": "browser",
      "fallback": "browser_isolated"
    },
    "main": {
      "note": "Owner's MAIN Chrome 'Profile 9' - WhatsApp Web, Gemini, general browsing - via the Playwright Extension",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82",
        "--extension",
        "--profile-dir-name",
        "Profile 9",
        "--output-dir",
        "D:\\ISHTI\\data\\mcp_output"
      ],
      "token_key": "whatsapp",
      "fallback": "browser_isolated"
    },
    "browser_isolated": {
      "note": "Fallback until the extension is set up: ISHTI's own separate profile, no logins",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82",
        "--user-data-dir",
        "D:\\ISHTI\\data\\mcp_browser_profile",
        "--output-dir",
        "D:\\ISHTI\\data\\mcp_output"
      ]
    }
  },
  "browser_profiles": {
    "note": "Which Chrome profile (mcp_servers entry) each skill browses with; skills not listed use default",
    "default": "main",
    "whatsapp": "main",
    "gemini": "main",
    "online_fallback": "main",
    "email": "login",
    "login": "login",
    "calendar": "main",
    "travel": "main",
    "extract": "main",
    "contacts": "main"
  },
