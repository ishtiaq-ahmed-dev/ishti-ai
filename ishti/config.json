{
  "llm": {
    "base_url": "http://127.0.0.1:11434/v1",
    "models": {
      "planner": "ishti-qwen2.5:14b",
      "coder": "ishti-qwen2.5-coder:14b",
      "fast": "llama3.2:3b",
      "translator": "gemma3:4b"
    },
    "fallback": "qwen2.5:14b",
    "timeout_s": 120
  },
  "memory": {
    "db_path": "D:\\ISHTI\\data\\ishti.db",
    "chroma_dir": "D:\\ISHTI\\data\\chroma",
    "embed_model": "nomic-embed-text",
    "embed_url": "http://127.0.0.1:11434",
    "search_roots": ["D:\\", "~\\Desktop", "~\\Downloads"],
    "search_max_depth": 4,
    "search_budget_s": 10
  },
  "router": {
    "use_laya": true,
    "laya_model": "typed-decisions",
    "min_confidence": 0.2,
    "default_skill": "chat"
  },
  "mcp_servers": {
    "login": {
      "note": "Owner's Chrome 'Profile 10' - for logins only (Google sign-in, Gmail) - via the Playwright Extension; token in data/mcp_tokens.json",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82", "--extension", "--profile-dir-name", "Profile 10",
               "--output-dir", "D:\\ISHTI\\data\\mcp_output"],
      "token_key": "browser",
      "fallback": "browser_isolated"
    },
    "main": {
      "note": "Owner's MAIN Chrome 'Profile 9' - WhatsApp Web, Gemini, general browsing - via the Playwright Extension",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82", "--extension", "--profile-dir-name", "Profile 9",
               "--output-dir", "D:\\ISHTI\\data\\mcp_output"],
      "token_key": "whatsapp",
      "fallback": "browser_isolated"
    },
    "browser_isolated": {
      "note": "Fallback until the extension is set up: ISHTI's own separate profile, no logins",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82", "--user-data-dir", "D:\\ISHTI\\data\\mcp_browser_profile",
               "--output-dir", "D:\\ISHTI\\data\\mcp_output"]
    }
  },
  "browser_profiles": {
    "note": "Which Chrome profile (mcp_servers entry) each skill browses with; skills not listed use default",
    "default": "main", "whatsapp": "main", "gemini": "main", "online_fallback": "main", "email": "login", "login": "login", "calendar": "login", "travel": "main", "extract": "main", "contacts": "login"
  },
  "voice": {
    "whisper_model": "large-v3",
    "whisper_device": "cuda",
    "whisper_compute": "int8_float16",
    "wake_enabled": true,
    "wake_model": "hey_jarvis",
    "wake_phrases": ["hey ishti", "hey jarvis", "hey my assistant"],
    "languages": ["en", "ur", "ps"],
    "wake_threshold": 0.5,
    "barge_in": {"enabled": true, "vad_threshold": 0.6, "min_ms": 120, "check_ms": 700, "echo_overlap": 0.5, "cooldown_s": 1.0,
                 "note": "Tune on the real room: raise vad_threshold/min_ms if speaker echo interrupts; lower echo_overlap if your own words get ignored"},
    "voices": [
      {"name": "Male 1 - Deep/Calm", "piper_voice": "en_US-norman-medium", "length_scale": 1.08},
      {"name": "Male 2 - Energetic", "piper_voice": "en_US-bryce-medium", "length_scale": 0.82},
      {"name": "Male 3 - Clear", "piper_voice": "en_US-ryan-high", "length_scale": 1.0},
      {"name": "Female 1 - Neutral", "piper_voice": "en_US-lessac-medium", "length_scale": 1.0}
    ],
    "default_voice": "Female 1 - Neutral",
    "voices_note": "Piper voices from rhasspy/piper-voices (synthetic, trained on open datasets - no real person cloned). The owner switches with 'use the deep male voice'; the choice is the fact owner.voice. Fish Audio S2 slots in here later (engine + reference clip per voice).",
    "piper_voice": "en_US-lessac-medium",
    "piper_dir": "D:\\ISHTI\\data\\piper"
  }
}
